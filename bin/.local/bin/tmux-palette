#!/usr/bin/env bash
# Generate tmux status colors from the active Omarchy palette and reload tmux.
# Writes ~/.config/tmux/theme.conf, which tmux.conf sources (overriding the
# hardcoded green). Called by dynamic-theme after a theme change.
set -uo pipefail
# Omarchy 4 moved generated theme state to ~/.local/state; Omarchy 3 used ~/.config.
for candidate in "$HOME/.local/state/omarchy/current/theme/colors.toml" \
                 "$HOME/.config/omarchy/current/theme/colors.toml"; do
  [ -r "$candidate" ] && { OMARCHY_COLORS="$candidate"; break; }
done
TOML="${1:-${OMARCHY_COLORS:-}}"
OUT="$HOME/.config/tmux/theme.conf"
[ -r "$TOML" ] || exit 0

get() { grep -E "^$1[[:space:]]*=" "$TOML" 2>/dev/null | sed -E 's/.*"(#[0-9a-fA-F]{6})".*/\1/' | head -1; }
BG="$(get background)"; FG="$(get foreground)"; AC="$(get accent)"
DIM="$(get color8)"; SEL="$(get color4)"
[ -n "$BG" ] && [ -n "$FG" ] && [ -n "$AC" ] || exit 0
[ -n "$DIM" ] || DIM="$FG"

cat > "$OUT" <<EOF
# Generated by tmux-palette from the active Omarchy theme. Do not edit by hand.
set -g status-style "bg=$BG fg=$FG"
set -g status-left "#[bg=$AC,fg=$BG,bold] #S #[bg=$BG,fg=$AC,none] "
set -g window-status-current-format "#[fg=$AC,bold] #W "
set -g window-status-format "#[fg=$DIM] #W "
set -g pane-active-border-style "fg=$AC"
set -g pane-border-style "fg=$DIM"
set -g mode-style "bg=$AC,fg=$BG"
EOF

# Reload the running server (if any) so it applies immediately.
TMUX_TMPDIR=/tmp tmux source-file "$HOME/.config/tmux/tmux.conf" >/dev/null 2>&1 || true
