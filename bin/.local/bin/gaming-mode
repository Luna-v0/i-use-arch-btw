#!/bin/bash

# Toggle a low-overhead compositor profile for gaming.
#
# Follows Omarchy's toggle idiom: the profile is a generated Lua file in
# ~/.local/state/omarchy/toggles/hypr/, which hyprland.lua sources LAST, so
# everything here overrides looknfeel.lua and monitors.lua. Removing the file
# and reloading restores the normal desktop exactly -- nothing is edited in
# place, so this is fully reversible.
#
#   gaming-mode          toggle
#   gaming-mode on|off   force a state
#   gaming-mode status   print current state
#
# Not touched here: the qwen-coder container still holds ~12.9 GB of VRAM.
# Stop it separately (docker stop qwen-coder) before anything demanding.

set -euo pipefail

TOGGLE_FLAG="$HOME/.local/state/omarchy/toggles/hypr/gaming-mode.lua"
# The TV, matched by EDID description (as in hypr/monitors.lua) so this keeps
# working when the connector name changes with the cabling.
SECONDARY_DESC="LG Electronics LG TV 0x01010101"
SECONDARY="desc:$SECONDARY_DESC"

# Quickshell side. shell.json hot-reloads, so removing the plugin takes effect
# without restarting the shell. Only the ids listed here are touched; what was
# actually removed is recorded so toggling off restores exactly those and
# leaves any other edits to shell.json alone.
SHELL_JSON="$HOME/.config/omarchy/shell.json"
REMOVED_PLUGINS="$HOME/.local/state/omarchy/gaming-mode-removed-plugins.json"
HEAVY_PLUGINS='["lunav0.livebg"]'   # infinitely-looping drifting aurora

shell_plugins() {
  python3 - "$SHELL_JSON" "$REMOVED_PLUGINS" "$HEAVY_PLUGINS" "$1" <<'PYEOF'
import json, sys, pathlib
shell_json, removed_path, heavy, action = sys.argv[1:5]
shell_p, removed_p = pathlib.Path(shell_json), pathlib.Path(removed_path)
if not shell_p.exists():
    sys.exit(0)
cfg = json.loads(shell_p.read_text())
plugins = cfg.get("plugins", [])
heavy = set(json.loads(heavy))

if action == "strip":
    keep = [x for x in plugins if x.get("id") not in heavy]
    drop = [x for x in plugins if x.get("id") in heavy]
    if not drop:
        sys.exit(0)
    removed_p.parent.mkdir(parents=True, exist_ok=True)
    removed_p.write_text(json.dumps(drop, indent=2))
    cfg["plugins"] = keep
else:  # restore
    if not removed_p.exists():
        sys.exit(0)
    drop = json.loads(removed_p.read_text())
    have = {x.get("id") for x in plugins}
    cfg["plugins"] = plugins + [x for x in drop if x.get("id") not in have]
    removed_p.unlink()

shell_p.write_text(json.dumps(cfg, indent=2, sort_keys=True) + "\n")
print(",".join(x.get("id","?") for x in drop))
PYEOF
}

notify() {
  command -v omarchy-notification-send >/dev/null 2>&1 &&
    omarchy-notification-send -g 󰊴 "$1" || echo "$1"
}

active_monitors() { hyprctl monitors -j | grep -c '"name"' || true; }

on() {
  # Refuse to blank the only display if the ultrawide ever goes missing.
  local disable_secondary=""
  if hyprctl monitors -j | grep -qF "\"$SECONDARY_DESC\""; then
    if [[ $(hyprctl monitors -j | grep -c '"id"') -gt 1 ]]; then
      disable_secondary="hl.monitor({ output = \"$SECONDARY\", disabled = true })"
    fi
  fi

  mkdir -p "$(dirname "$TOGGLE_FLAG")"
  cat >"$TOGGLE_FLAG" <<EOF
-- GENERATED by \`gaming-mode\` -- do not edit; run \`gaming-mode off\` to remove.

-- looknfeel.lua runs a borderangle loop animation, which redraws the border of
-- every window on every frame indefinitely. Disabling animations stops that.
-- (blur and shadows are already off in this setup, so there is nothing to gain
-- there -- verified with hyprctl getoption.)
hl.config({
  animations = { enabled = false },
  decoration = { rounding = 0 },

  -- Lets games that ask for immediate presentation tear instead of waiting for
  -- the compositor. Only affects windows with an \`immediate\` rule.
  general = { allow_tearing = true },
})

-- looknfeel.lua sets a global 0.90/0.80 opacity, so every window is alpha
-- blended against what is behind it every frame. Opaque is cheaper.
-- Toggles load last, and the later matching rule wins.
o.window(".*", { opacity = "1.0 1.0" })

$( [[ -n $disable_secondary ]] && cat <<INNER
-- Single screen: the second output is composited and scanned out even when
-- nothing on it changes. Windows on its workspaces move to the ultrawide and
-- return when this mode is switched off.
$disable_secondary
INNER
)
EOF

  hyprctl reload >/dev/null
  local dropped
  dropped=$(shell_plugins strip)
  notify "Gaming mode ON${disable_secondary:+ - $SECONDARY disabled}${dropped:+ - paused $dropped}"
}

off() {
  rm -f "$TOGGLE_FLAG"
  hyprctl reload >/dev/null
  shell_plugins restore >/dev/null
  notify "Gaming mode OFF"
}

case "${1:-toggle}" in
  on) on ;;
  off) off ;;
  toggle) if [[ -f $TOGGLE_FLAG ]]; then off; else on; fi ;;
  status) [[ -f $TOGGLE_FLAG ]] && echo "on" || echo "off" ;;
  *) echo "Usage: gaming-mode [on|off|toggle|status]" >&2; exit 1 ;;
esac
