#!/usr/bin/env bash

# Decide, per application, whether it renders on the RTX card instead of the
# iGPU that runs the desktop.
#
# The desktop composites on the iGPU (monitors are on the motherboard ports), so
# apps render there by default. This routes chosen apps through `prime-run`
# (PRIME render offload: RTX renders, iGPU scans out) by writing a .desktop
# override into ~/.local/share/applications, which takes precedence over the
# packaged entry in /usr/share/applications.
#
#   gpu-app                   interactive picker (fzf): search, Enter toggles
#   gpu-app add blender       route Blender to the RTX card
#   gpu-app rm blender        back to the iGPU
#   gpu-app list              what is currently routed
#   gpu-app search krita      find the .desktop id for an app
#
# Nothing here is destructive: `add` only ever creates a file in your own
# applications dir, `rm` deletes that same file, and the packaged entry
# underneath is never touched.
#
# Caveats:
#   - The GPU is bound when the process creates its graphics context, so a
#     running app cannot be moved. Quit and relaunch it.
#   - Compute (CUDA, inference, PyTorch) already uses the RTX card directly and
#     needs none of this.
#   - Single-instance apps (ghostty, Chromium) hand new windows to the process
#     that is already running, so quit every instance before the change applies.

set -euo pipefail

LOCAL_DIR="$HOME/.local/share/applications"
SYS_DIRS=(/usr/share/applications /usr/local/share/applications "$HOME/.local/share/flatpak/exports/share/applications" /var/lib/flatpak/exports/share/applications)

die() { echo "gpu-app: $*" >&2; exit 1; }

# Resolve a loose name ("blender") to a .desktop basename, preferring an exact
# id match over a substring one so "code" does not pick "codeblocks".
resolve() {
  local q="${1%.desktop}" exact=() loose=()
  for d in "${SYS_DIRS[@]}"; do
    [[ -d $d ]] || continue
    while IFS= read -r f; do
      local b; b=$(basename "$f" .desktop)
      if [[ ${b,,} == "${q,,}" ]]; then exact+=("$b")
      elif [[ ${b,,} == *"${q,,}"* ]]; then loose+=("$b"); fi
    done < <(find "$d" -maxdepth 1 -name '*.desktop' 2>/dev/null)
  done
  printf '%s\n' "${exact[@]}" "${loose[@]}" 2>/dev/null | awk 'NF' | awk '!seen[$0]++'
}

find_source() {
  local id="$1"
  for d in "${SYS_DIRS[@]}"; do
    [[ -f "$d/$id.desktop" ]] && { echo "$d/$id.desktop"; return 0; }
  done
  return 1
}

cmd_add() {
  [[ $# -ge 1 ]] || die "usage: gpu-app add <app>"
  local matches; mapfile -t matches < <(resolve "$1")
  ((${#matches[@]})) || die "no .desktop found matching '$1' (try: gpu-app search $1)"
  if ((${#matches[@]} > 1)) && [[ ${matches[0],,} != "${1,,}" ]]; then
    echo "gpu-app: '$1' is ambiguous, pick one:" >&2
    printf '  %s\n' "${matches[@]}" >&2
    exit 1
  fi
  local id="${matches[0]}" src
  src=$(find_source "$id") || die "cannot locate source .desktop for $id"

  mkdir -p "$LOCAL_DIR"
  # Prefix every Exec= with prime-run, and disable DBus activation: a
  # DBus-activated app is started by the service file, which would bypass
  # Exec= entirely and silently leave the app on the iGPU.
  sed -e 's|^Exec=|Exec=prime-run |' \
      -e 's|^DBusActivatable=true|DBusActivatable=false|' \
      "$src" > "$LOCAL_DIR/$id.desktop"

  grep -q '^Exec=prime-run ' "$LOCAL_DIR/$id.desktop" ||
    die "no Exec= line rewritten in $id - inspect $LOCAL_DIR/$id.desktop"

  update-desktop-database "$LOCAL_DIR" 2>/dev/null || true
  echo "$id -> RTX card (relaunch it; quit existing windows first)"
}

cmd_rm() {
  [[ $# -ge 1 ]] || die "usage: gpu-app rm <app>"
  local id="${1%.desktop}" hit=0
  for f in "$LOCAL_DIR/$id.desktop"; do
    [[ -f $f ]] && grep -q '^Exec=prime-run ' "$f" && { rm -f "$f"; hit=1; }
  done
  if ((!hit)); then
    # allow a loose name too
    while IFS= read -r f; do
      grep -q '^Exec=prime-run ' "$f" || continue
      [[ $(basename "$f" .desktop) == *"$id"* ]] || continue
      rm -f "$f"; hit=1; echo "removed $(basename "$f" .desktop)"
    done < <(find "$LOCAL_DIR" -maxdepth 1 -name '*.desktop' 2>/dev/null)
  else
    echo "$id -> iGPU (packaged entry restored)"
  fi
  ((hit)) || die "'$1' is not routed to the RTX card"
  update-desktop-database "$LOCAL_DIR" 2>/dev/null || true
}

cmd_list() {
  local found=0
  while IFS= read -r f; do
    grep -q '^Exec=prime-run ' "$f" 2>/dev/null || continue
    found=1
    printf '  %-40s %s\n' "$(basename "$f" .desktop)" "$(grep -m1 '^Name=' "$f" | cut -d= -f2-)"
  done < <(find "$LOCAL_DIR" -maxdepth 1 -name '*.desktop' 2>/dev/null | sort)
  ((found)) || echo "  (nothing routed to the RTX card)"
}

cmd_search() { [[ $# -ge 1 ]] || die "usage: gpu-app search <text>"; resolve "$1" | sed 's/^/  /'; }

# True when this app currently has a prime-run override of our making.
is_routed() { [[ -f "$LOCAL_DIR/$1.desktop" ]] && grep -q '^Exec=prime-run ' "$LOCAL_DIR/$1.desktop"; }

cmd_toggle() {
  [[ $# -ge 1 ]] || die "usage: gpu-app toggle <id>"
  if is_routed "$1"; then cmd_rm "$1"; else cmd_add "$1"; fi
}

# One row per launchable app: <state>TAB<id>TAB<display name>.
# Consumed by the picker, and re-run on every toggle to redraw in place.
cmd_rows() {
  local -A seen=()
  { for d in "${SYS_DIRS[@]}"; do
      [[ -d $d ]] && find "$d" -maxdepth 1 -name '*.desktop' 2>/dev/null
    done
  } | sort | while IFS= read -r f; do
    local id; id=$(basename "$f" .desktop)
    [[ -n ${seen[$id]:-} ]] && continue
    seen[$id]=1
    # Skip entries the launcher itself hides, and non-applications.
    grep -qi '^NoDisplay=true' "$f" && continue
    grep -qi '^Hidden=true' "$f" && continue
    local name; name=$(grep -m1 '^Name=' "$f" | cut -d= -f2-)
    [[ -z $name ]] && name=$id
    if is_routed "$id"; then
      printf '\033[1;32m● RTX \033[0m\t%s\t%s\n' "$id" "$name"
    else
      printf '\033[2m· iGPU\033[0m\t%s\t%s\n' "$id" "$name"
    fi
  done
}

# Detail pane for the highlighted row.
cmd_show() {
  local id="${1:-}"; [[ -n $id ]] || return 0
  local src; src=$(find_source "$id" 2>/dev/null || true)
  if is_routed "$id"; then
    echo "RENDERS ON: RTX 4060 Ti (PRIME offload)"
  else
    echo "RENDERS ON: AMD iGPU (desktop default)"
  fi
  echo
  echo "id:     $id"
  [[ -n $src ]] && echo "source: $src"
  is_routed "$id" && echo "override: $LOCAL_DIR/$id.desktop"
  echo
  if is_routed "$id"; then
    grep -m2 -E '^Exec=' "$LOCAL_DIR/$id.desktop" 2>/dev/null
  elif [[ -n $src ]]; then
    grep -m2 -E '^Exec=' "$src" 2>/dev/null
  fi
  echo
  echo "Enter toggles. Changes apply to NEW launches --"
  echo "quit the app first (all windows for single-instance apps)."
}

cmd_tui() {
  command -v fzf >/dev/null || die "fzf is required for the picker (try: gpu-app list)"
  local self="${BASH_SOURCE[0]}"
  cmd_rows | fzf \
    --ansi \
    --delimiter='\t' \
    --with-nth='1,3' \
    --nth='3' \
    --header=$'Enter toggles GPU  |  Ctrl-R refresh  |  Esc quit\n● RTX = dedicated card, · iGPU = desktop default' \
    --header-first \
    --prompt='app> ' \
    --preview="$self show {2}" \
    --preview-window='right,52%,wrap' \
    --bind="enter:execute-silent($self toggle {2})+reload($self _rows)" \
    --bind="ctrl-r:reload($self _rows)" \
    --no-sort \
    >/dev/null || true
}

case "${1:-tui}" in
  add)    shift; cmd_add "$@" ;;
  rm|remove) shift; cmd_rm "$@" ;;
  toggle) shift; cmd_toggle "$@" ;;
  list|ls) cmd_list ;;
  search) shift; cmd_search "$@" ;;
  tui|ui|pick) cmd_tui ;;
  _rows)  cmd_rows ;;
  show)   shift; cmd_show "$@" ;;
  -h|--help|help) echo "usage: gpu-app [tui|add|rm|toggle|list|search] <app>" ;;
  *) echo "usage: gpu-app [tui|add|rm|toggle|list|search] <app>" >&2; exit 1 ;;
esac
