#!/usr/bin/env python3
"""Extract an Omarchy colors.toml palette from an image.

Usage: wallpaper-palette <image> <out-colors.toml>

Builds a full dark 16-color scheme (accent/cursor/fg/bg/selection + color0-15)
from the image's dominant colors, with a WCAG contrast guard so text is never
invisible on the generated background (a recurring pain on dark green themes).
"""
import sys
import colorsys
from PIL import Image


def clamp(x, lo=0.0, hi=1.0):
    return max(lo, min(hi, x))


def hexof(rgb):
    return "#{:02x}{:02x}{:02x}".format(*[int(round(clamp(c) * 255)) for c in rgb])


def rel_lum(rgb):
    # WCAG relative luminance; rgb in 0..1
    def f(c):
        return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4
    r, g, b = rgb
    return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b)


def contrast(a, b):
    la, lb = rel_lum(a), rel_lum(b)
    hi, lo = max(la, lb), min(la, lb)
    return (hi + 0.05) / (lo + 0.05)


def ensure_contrast(fg, bg, target=4.5):
    """Lighten fg (raise HSV value, then desaturate) until it clears `target` vs bg."""
    h, s, v = colorsys.rgb_to_hsv(*fg)
    for _ in range(60):
        if contrast(colorsys.hsv_to_rgb(h, s, v), bg) >= target:
            break
        if v < 1.0:
            v = clamp(v + 0.03)
        else:
            s = clamp(s - 0.04)
    return colorsys.hsv_to_rgb(h, s, v)


def hue_dist(a, b):
    d = abs(a - b)
    return min(d, 1 - d)


def gradient_stops(im, bg, accent, max_stops=4):
    """2-4 colours actually present in the image, ordered by hue.

    Chromatic clusters are ranked by pixel share weighted by saturation (so a
    small vivid highlight can beat a large grey area) and picked greedily with a
    minimum hue gap, so the stops are the image's distinct colours rather than
    four shades of the same one. Each is lifted to 4.5:1 against the background
    because the bar draws its glyphs in this gradient.
    """
    q = im.quantize(colors=32, method=Image.Quantize.MEDIANCUT)
    pal = q.getpalette()
    total = sum(n for n, _ in q.getcolors() or []) or 1
    cands = []
    for n, idx in q.getcolors() or []:
        c = tuple(x / 255 for x in pal[idx * 3:idx * 3 + 3])
        h, s, v = colorsys.rgb_to_hsv(*c)
        if s < 0.18 or v < 0.12 or n / total < 0.004:
            continue
        cands.append(((n / total) ** 0.5 * s * (0.4 + v), h, c))
    cands.sort(reverse=True)

    picked = []
    for _, h, c in cands:
        if all(hue_dist(h, ph) >= 0.10 for ph, _ in picked):
            picked.append((h, c))
        if len(picked) == max_stops:
            break

    # A touch more saturation than the raw cluster, so a thin border line reads
    # as a colour rather than grey; hue is untouched.
    def lift(c):
        h, s, v = colorsys.rgb_to_hsv(*c)
        return ensure_contrast(colorsys.hsv_to_rgb(h, clamp(s * 1.2), v), bg, 4.5)

    stops = [lift(c) for _, c in sorted(picked)]
    if len(stops) < 2:
        # Near-monochrome image: accent into a lighter tint of the same hue.
        h, s, v = colorsys.rgb_to_hsv(*accent)
        stops = [accent, ensure_contrast(colorsys.hsv_to_rgb(h, s * 0.5, 0.95), bg, 4.5)]
    return stops


def main():
    if len(sys.argv) != 3:
        sys.exit("usage: wallpaper-palette <image> <out-colors.toml>")
    img_path, out_path = sys.argv[1], sys.argv[2]

    im = Image.open(img_path).convert("RGB")
    im.thumbnail((400, 400))
    q = im.quantize(colors=16, method=Image.Quantize.MEDIANCUT)
    pal = q.getpalette()
    ranked = []  # (count, (r,g,b) in 0..1)
    for count, idx in sorted(q.getcolors() or [], reverse=True):
        r, g, b = pal[idx * 3:idx * 3 + 3]
        ranked.append((count, (r / 255, g / 255, b / 255)))
    dom = [c for _, c in ranked] or [(0.2, 0.5, 0.4)]

    def satval(c):
        _, s, v = colorsys.rgb_to_hsv(*c)
        return s * v

    base = dom[0]
    vivid = max(dom, key=satval)
    hb, sb, _ = colorsys.rgb_to_hsv(*base)

    # Deep tinted background + high-contrast light foreground.
    bg = colorsys.hsv_to_rgb(hb, clamp(sb * 0.6), 0.09)
    fg = ensure_contrast(colorsys.hsv_to_rgb(hb, 0.10, 0.92), bg, 8.0)
    accent = ensure_contrast(vivid, bg, 4.5)

    # Map dominant colors onto the 6 canonical ANSI hues; synthesize if absent.
    canon = {1: 0.00, 2: 0.33, 3: 0.13, 4: 0.58, 5: 0.83, 6: 0.50}

    def nearest_sv(target_h):
        # saturation/value of the dominant color closest in hue (or None)
        best, bd = None, 9.0
        for c in dom:
            h, s, v = colorsys.rgb_to_hsv(*c)
            if s < 0.15:
                continue
            d = min(abs(h - target_h), 1 - abs(h - target_h))
            if d < bd:
                bd, best = d, (s, v)
        return best

    ansi = {}
    ansi[0] = colorsys.hsv_to_rgb(hb, clamp(sb * 0.5), 0.16)
    ansi[8] = colorsys.hsv_to_rgb(hb, clamp(sb * 0.4), 0.36)
    ansi[7] = ensure_contrast(colorsys.hsv_to_rgb(hb, 0.08, 0.80), bg, 5.0)
    ansi[15] = ensure_contrast(colorsys.hsv_to_rgb(hb, 0.05, 0.97), bg, 7.0)
    # ANSI 1-6 keep their CANONICAL hue (so red/green/yellow/blue/magenta/cyan
    # stay distinct and recognizable even when the image lacks those hues), but
    # take saturation/brightness from the nearest dominant color so the set still
    # reflects the image's mood.
    for i, th in canon.items():
        sv = nearest_sv(th)
        s = clamp(sv[0] if sv else 0.72, 0.55, 0.95)
        v = clamp(max(sv[1], 0.62) if sv else 0.74, 0.60, 0.86)
        c = ensure_contrast(colorsys.hsv_to_rgb(th, s, v), bg, 4.5)
        ansi[i] = c
        h2, s2, v2 = colorsys.rgb_to_hsv(*c)
        ansi[i + 8] = ensure_contrast(colorsys.hsv_to_rgb(h2, clamp(s2 * 0.9), clamp(v2 + 0.15)), bg, 4.5)

    head = {
        "accent": accent, "cursor": fg, "foreground": fg, "background": bg,
        "selection_foreground": fg, "selection_background": accent,
    }
    lines = [f'{k} = "{hexof(v)}"' for k, v in head.items()] + [""]
    lines += [f'color{i} = "{hexof(ansi[i])}"' for i in range(16)]

    # Window border + bar glyph gradient, taken from the image's own colours
    # (the ANSI set above is deliberately full-spectrum, so a gradient built
    # from it is a rainbow whatever the wallpaper). Omarchy 4 renders this key
    # into hyprland.lua and shell.toml, so it reaches the window borders, the
    # bar's gradient glyphs, and the notification/popup/lock chrome.
    stops = [hexof(c) for c in gradient_stops(im, bg, accent)]
    lines += [
        "",
        f'hyprland_active_border = "{" ".join(stops)} 45deg"',
        'hyprland_inactive_border = "color8"',
    ]
    with open(out_path, "w") as fh:
        fh.write("\n".join(lines) + "\n")
    print(f"palette -> {out_path}  bg={hexof(bg)} fg={hexof(fg)} accent={hexof(accent)} "
          f"(fg/bg contrast {contrast(fg, bg):.1f}:1)")


if __name__ == "__main__":
    main()
