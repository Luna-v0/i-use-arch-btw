#!/bin/bash

# Run a command with its GPU work on the integrated AMD Raphael iGPU
# (0f:00.0) instead of the discrete RTX 4060 Ti (01:00.0).
#
# Why: the 4060 Ti's 16 GB is mostly spoken for by the qwen-coder
# llama.cpp container. Desktop apps that only need to draw a window
# have no reason to hold VRAM there. Rendering them on the iGPU frees
# that memory for the model.
#
# Caveat: the compositor still runs on the NVIDIA card, so a window
# rendered here is an AMD dmabuf imported by an NVIDIA compositor.
# That path is driver-sensitive. If an app shows black/corrupt
# windows, just launch it without this wrapper.
#
#   igpu ghostty
#   igpu zen
#
# Verify with: nvidia-smi  (the app should no longer be listed)

exec env \
  __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json \
  __GLX_VENDOR_LIBRARY_NAME=mesa \
  DRI_PRIME=pci-0000_0f_00_0 \
  MESA_VK_DEVICE_SELECT=1002:164e \
  VK_DRIVER_FILES=/usr/share/vulkan/icd.d/radeon_icd.json \
  VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/radeon_icd.json \
  LIBVA_DRIVER_NAME=radeonsi \
  VDPAU_DRIVER=radeonsi \
  "$@"
