#!/usr/bin/env bash
# Peek the waybar: show it, then auto-hide after N seconds (default 5).
# Press again while it's showing to hide immediately. Matches the habit of
# keeping the bar closed and only glancing at it. Anti-burn: bar isn't static.
set -uo pipefail
N="${1:-5}"

if pgrep -x waybar >/dev/null 2>&1; then
  pkill -x waybar
  exit 0
fi

setsid uwsm-app -- waybar >/dev/null 2>&1 &
setsid bash -c "sleep ${N}; pkill -x waybar" >/dev/null 2>&1 &
