#!/usr/bin/env bash
# Render one program on the RTX card while the desktop runs on the iGPU
# (PRIME render offload: NVIDIA renders, the iGPU scans out). Same env as the
# nvidia-prime package's prime-run, without the extra dependency.
#   prime-run <cmd> [args...]      Steam launch options: prime-run %command%
export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export __VK_LAYER_NV_optimus=NVIDIA_only
export VK_LOADER_DRIVERS_SELECT='nvidia*'
exec "$@"
