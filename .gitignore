hypr/.config/hypr/input.config
hypr/.config/hypr/shaders/*


**/node_modules/

# Omarchy machine state — regenerated by `omarchy theme set`, never commit
omarchy/.config/omarchy/current/

# Editor / refresh backups
*.bak
*.bak.*
*.tui-migration.bak

# Dynamic wallpaper theme — palette + wallpaper are regenerated each boot
omarchy/.config/omarchy/themes/dynamic/colors.toml
omarchy/.config/omarchy/themes/dynamic/backgrounds/*
!omarchy/.config/omarchy/themes/dynamic/backgrounds/.gitkeep
omarchy/.config/omarchy/backgrounds/

# Python bytecode
__pycache__/
*.pyc

# Claude Code session state for this repo
.claude/
