// Two bars sharing all modules/layout from modules.jsonc:
//   - DP-2 (LG ultrawide, main): bar on TOP
//   - HDMI-A-1 (Samsung, second): bar on BOTTOM
// Edit modules/layout once in modules.jsonc; both bars pick it up.
[
  {
    "output": "DP-2",
    "position": "top",
    "include": ["~/.config/waybar/modules.jsonc"]
  },
  {
    "output": "HDMI-A-1",
    "position": "bottom",
    "include": ["~/.config/waybar/modules.jsonc"]
  }
]
